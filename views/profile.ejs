<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Profile</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <div class="phone-frame">
    <div class="phone-screen portfolio-screen">
      <div class="app-shell">
        <div class="app-header">
          <div class="header-row">
            <div>
              <p class="eyebrow">Account</p>
              <h1>Profile</h1>
            </div>
            <div class="status-pill">Verified</div>
          </div>
        </div>

        <div class="profile-card">
          <div class="avatar">AC</div>
          <h2>Alex Carter</h2>
          <p class="profile-email">alex@email.com</p>
        </div>

        <div class="card-section">
          <div class="info-card summary-list">
            <div class="summary-item"><strong>Risk tolerance:</strong> Moderate</div>
            <div class="summary-item"><strong>Time horizon:</strong> Long term</div>
            <div class="summary-item"><strong>Goal:</strong> Growth with protection</div>
            <div class="summary-item"><strong>Portfolio value:</strong> $124,850</div>
          </div>
        </div>

        <div class="chip-row">
          <button class="chip primary" type="button">Edit profile</button>
          <a class="chip" href="/portfolio">Back</a>
        </div>
      </div>
    </div>
  </div>
  <script src="/js/voice.js"></script>
</body>
</html>
