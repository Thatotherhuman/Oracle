<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>EKYC Required</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <div class="phone-frame">
    <div class="phone-screen portfolio-screen">
      <div class="app-shell">
        <div class="app-header">
          <div class="header-row">
            <div>
              <p class="eyebrow">Security</p>
              <h1>Verify identity</h1>
            </div>
            <div class="status-pill">Required</div>
          </div>
        </div>

        <div class="profile-card">
          <div class="avatar">ID</div>
          <h2>EKYC Check</h2>
          <p class="profile-email">We need to verify your identity to meet compliance standards.</p>
          <p class="profile-email">This screen explains what will happen next.</p>
        </div>

        <div class="card-section">
          <div class="info-card summary-list">
            <div class="summary-item"><strong>Regulation:</strong> Protected</div>
            <div class="summary-item"><strong>Security:</strong> Encrypted</div>
          </div>
        </div>

        <div class="chip-row">
          <a class="chip primary" href="/ekyc/details" data-voice-action="start-ekyc">Start EKYC</a>
          <a class="chip" href="/portfolio">Back</a>
        </div>
      </div>

      <div id="messageOverlay" class="message-overlay hidden" role="status" aria-live="polite">
        <div class="message-card">Welcome. You need to verify your identity before investing. Please begin the EKYC process.</div>
      </div>
    </div>
  </div>

  <script>
    const overlay = document.getElementById('messageOverlay');
    overlay.classList.remove('hidden');
    setTimeout(() => overlay.classList.add('hidden'), 4000);
  </script>
  <script src="/js/voice.js"></script>
</body>
</html>
