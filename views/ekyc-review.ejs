<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>EKYC Review</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <div class="phone-frame">
    <div class="phone-screen portfolio-screen">
      <div class="app-header">
        <h1>Step 3</h1>
        <p>Review and submit</p>
      </div>

      <div class="profile-stats">
        <div class="stat-card"><span>Identity verified</span><strong>Pending review</strong></div>
        <div class="stat-card"><span>Compliance</span><strong>Regulation checked</strong></div>
        <div class="stat-card"><span>Access</span><strong>Investing unlocked</strong></div>
      </div>

      <div class="profile-card">
        <p class="profile-email">Please review these details before you submit. This confirms your account meets compliance standards.</p>
      </div>

      <div class="menu-list">
        <a class="menu-btn" href="/ekyc/success" data-voice-action="submit-verification">Submit verification</a>
        <a class="menu-btn exit-btn" href="/ekyc/identity">Back</a>
      </div>

      <div id="messageOverlay" class="message-overlay hidden" role="status" aria-live="polite">
        <div class="message-card">Please review the information. Submit verification to complete the process.</div>
      </div>
    </div>
  </div>

  <script>
    const overlay = document.getElementById('messageOverlay');
    overlay.classList.remove('hidden');
    setTimeout(() => overlay.classList.add('hidden'), 4000);
  </script>
  <script src="/js/voice.js"></script>
</body>
</html>
