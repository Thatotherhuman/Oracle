<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Accessibility Options</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <div class="phone-frame">
    <div class="phone-screen portfolio-screen">
      <div class="app-header">
        <h1>Accessibility</h1>
        <p>Settings for easier use</p>
      </div>

      <div class="profile-card">
        <div class="avatar">♿</div>
        <h2>Voice guided mode</h2>
        <p class="profile-email">Large text, high contrast, and spoken-style guidance are enabled.</p>
      </div>

      <div class="profile-stats">
        <div class="stat-card"><span>Text size</span><strong>Large</strong></div>
        <div class="stat-card"><span>Contrast</span><strong>High</strong></div>
        <div class="stat-card"><span>Guidance</span><strong>Voice-style prompts</strong></div>
      </div>

      <div class="menu-list">
        <a class="menu-btn" href="/">Repeat instructions</a>
        <a class="menu-btn exit-btn" href="/">Back</a>
      </div>
    </div>
  </div>
  <script src="/js/voice.js"></script>
</body>
</html>
