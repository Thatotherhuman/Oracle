<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Risk Profile</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <div class="phone-frame">
    <div class="phone-screen portfolio-screen">
      <div class="app-header">
        <h1>Risk Profile</h1>
        <p>Your investment comfort level</p>
      </div>

      <div class="profile-card">
        <div class="avatar">⚖</div>
        <h2>Moderate</h2>
        <p class="profile-email">This profile helps the app recommend suitable investments.</p>
      </div>

      <div class="profile-stats">
        <div class="stat-card"><span>Time horizon</span><strong>Long term</strong></div>
        <div class="stat-card"><span>Preferred risk</span><strong>Moderate</strong></div>
        <div class="stat-card"><span>Goal</span><strong>Growth with protection</strong></div>
      </div>

      <div class="menu-list">
        <a class="menu-btn" href="/ekyc">Continue to EKYC</a>
        <a class="menu-btn exit-btn" href="/">Back</a>
      </div>
    </div>
  </div>
  <script src="/js/voice.js"></script>
</body>
</html>
