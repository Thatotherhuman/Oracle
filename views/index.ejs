<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Mobile App Homepage</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <div class="phone-frame">
    <div class="phone-screen">
      <div class="app-shell">
        <div class="app-header">
          <div class="header-row">
            <div>
              <p class="eyebrow">Wealth app</p>
              <h1>Welcome back</h1>
            </div>
            <div class="status-pill">● Online</div>
          </div>
        </div>

        <div class="hero-card">
          <div>
            <p class="muted">Portfolio balance</p>
            <h2>$124,850</h2>
            <p class="muted">+8.2% this month</p>
          </div>
          <div class="hero-badge">AI insights</div>
        </div>

        <div class="card-section">
          <div class="section-title">
            <h3>Your holdings</h3>
            <span>Swipe to browse</span>
          </div>
          <div class="stock-row">
            <div class="stock-card accent-blue">
              <h4>Solaris</h4>
              <div class="stock-price">$42.18</div>
              <div class="stock-change negative">-1.4%</div>
            </div>
            <div class="stock-card">
              <h4>Concrete TM</h4>
              <div class="stock-price">$86.40</div>
              <div class="stock-change positive">+3.2%</div>
            </div>
            <div class="stock-card accent-red">
              <h4>Northstar</h4>
              <div class="stock-price">$28.95</div>
              <div class="stock-change negative">-0.8%</div>
            </div>
          </div>
        </div>

        <div class="card-section">
          <div class="section-title">
            <h3>Quick actions</h3>
          </div>
          <div class="chip-row">
            <a class="chip primary" href="/ekyc">Start EKYC</a>
            <a class="chip" href="/portfolio">Open portfolio</a>
            <a class="chip" href="/solaris">View Solaris</a>
          </div>
        </div>
      </div>
    </div>
  </div>
  <script src="/js/voice.js"></script>
</body>
</html>
